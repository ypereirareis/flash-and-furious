# Copy to .env (git-ignored) and adapt: docker compose reads it automatically.

# ---- Photos folder on the host ----
# A local folder (relative to this project or absolute)...
PHOTOS_PATH=./photos
# ...or a folder on an external disk, e.g.:
# PHOTOS_PATH=/mnt/photos/flash-and-furious

# Missing folder: true = created at start-up (owned by PUID:PGID), false = docker compose refuses to start.
PHOTOS_CREATE=true

# true = the folder must be on another disk than this project (external disk). If the disk is not
# plugged in or not mounted, photos are blocked and an alert is shown, instead of silently filling
# the system disk (e.g. the Raspberry Pi SD card).
PHOTOS_EXTERNAL=false

# Photos are blocked (with an alert) when less than this is left on the disk, in MB.
STORAGE_MIN_FREE_MB=200

# Owner of the photos created on the host (`id -u` / `id -g`)
PUID=1000
PGID=1000
